# GEMINI_API_KEY: required for the AI Yoga Teacher.
# Without it /api/ai/ask still responds, but reports itself as degraded and
# returns canned guidance instead of a generated answer.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: where this app is hosted. Used for self-referential links.
APP_URL="MY_APP_URL"

# VITE_HUMAN_MODEL_URL: optional override for the 3D model path.
# Defaults to the candidates in src/config/model.ts (/models/model.glb,
# /model/model.glb, /models/human.glb).
# VITE_HUMAN_MODEL_URL="/models/human.glb"
